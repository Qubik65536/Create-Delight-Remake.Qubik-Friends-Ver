    "auto": {
      // 加算，全自动模式的开火数值调整，如无调整可不写
      "damage": 0,
      "rpm": 0,
      "speed": 0,
      "knockback": 0,
      "armor_ignore": 0,
      "head_shot_multiplier": 0,
      "aim_inaccuracy": 0,
      "other_inaccuracy": 0
    },
    // 半自动状态的数值调整，如无调整可不写
    "semi": {
      // 加算，半自动模式的开火数值调整，如无调整可不写
      "damage": 5,
      "rpm": -320,
      "speed": 20,
      "knockback": 0.1,
      "armor_ignore": 0.1,
      "head_shot_multiplier": 0.5,
      "aim_inaccuracy": -0.1,
      "other_inaccuracy": -0.5
    }
    // 多连发状态的数值调整，如无调整可不写

      {"time": 0, "value": [-0.475, 0.35]},
      {"time": 0.25, "value": [-0.475, 0.35]},
      {"time": 0.45, "value": [0, 0]}
    ]
  },
  "inaccuracy": {
    "stand": 5.5,
    "move": 6,
    "sneak": 5.25,
    "lie": 4,
    "aim": 0.075
  },

+  # Re-tag HEAD of the release branch with the current pack version.
+  # Runs only on the `release` branch, after all build jobs complete.
+  tag-release:
+    name: "[Qubik Friends Ver Patch] Tag Patch Release"
+    needs: [common-steps, client-tasks, server-tasks, patch-tasks]
+    runs-on: ubuntu-latest
+    if: github.ref_name == 'release'
+    permissions:
+      contents: write
+    env:
+      TAG: ${{ needs.common-steps.outputs.modpack_ver }}
+    steps:
+      - name: Checkout Release Branch
+        uses: actions/checkout@v4
+        with:
+          ref: release
+          fetch-depth: 1
+          token: ${{ secrets.GITHUB_TOKEN }}
+
+      - name: Tag HEAD with ${{ needs.common-steps.outputs.modpack_ver }}
+        run: |
+          git config user.name  "github-actions[bot]"
+          git config user.email "github-actions[bot]@users.noreply.github.com"
+          git tag "$TAG"
+          git push origin "$TAG"
